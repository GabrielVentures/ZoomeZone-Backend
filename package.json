{
  "name": "shelftagsnap-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for ShelfTagSnap - AI-powered shelf tag recognition with cost control",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint --ext .js,.ts .",
    "lint:fix": "eslint --ext .js,.ts . --fix"
  },
  "engines": {
    "node": "18"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.5.0",
    "openai": "^4.20.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.29.0",
    "typescript": "^5.2.0"
  },
  "private": true,
  "keywords": [
    "firebase",
    "cloud-functions",
    "openai",
    "gpt-4o",
    "cost-control",
    "quota-management"
  ],
  "author": "ShelfTagSnap Team",
  "license": "UNLICENSED"
}
